{
  "name": "ankermanager",
  "version": "1.0.0",
  "description": "AnkerMake M5 WiFi file manager + USB-gadget replug watchdog for a Raspberry Pi Zero 2 W",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run ankermanager.ts",
    "build": "bun build ankermanager.ts --compile --outfile ankermanager",
    "test": "bun test tests/unit",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "test:e2e": "playwright test --config=playwright.e2e.config.ts",
    "test:all": "bun run test && bun run test:ui && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.14"
  }
}
